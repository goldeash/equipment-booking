# Environment variables of the API. Copy the names into your environment or secret store;
# never commit real values. ASP.NET Core maps "__" to ":" in configuration keys.

# Database login of the API (member of app_write), for example:
# Host=<host>;Database=<database>;Username=eb_api;Password=<password>;SSL Mode=Require
ConnectionStrings__Default=

# Owner connection used only by dotnet ef and the seeder to apply migrations and load data
ConnectionStrings__Migrations=

# HMAC key for access tokens, at least 32 characters
Jwt__SigningKey=

# Allowed browser origins when the SPA is served from another origin
Cors__AllowedOrigins__0=

# Secret header value for POST /internal/jobs/{name}/runs; the endpoint is disabled when empty
Jobs__TriggerKey=

# Password of the demo accounts set by the seeder
EB_DEMO_PASSWORD=

# Integration tests: owner and application connections of a separate test database
EB_TEST_DB_OWNER_CONNECTION=
EB_TEST_DB_APP_CONNECTION=
