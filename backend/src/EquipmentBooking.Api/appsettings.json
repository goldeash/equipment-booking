{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "GlobalPermitsPerMinute": 300,
    "AuthenticationPermitsPerMinute": 10
  },
  "Jwt": {
    "Issuer": "equipment-booking-api",
    "Audience": "equipment-booking-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}
